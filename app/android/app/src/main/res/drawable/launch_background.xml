<?xml version="1.0" encoding="utf-8"?>
<!-- Arranque de Zanky: agua de marca con Zanky feliz al centro, hasta que Flutter pinta su primer cuadro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/zanky_arranque_fondo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/zanky_arranque" />
    </item>
</layer-list>
