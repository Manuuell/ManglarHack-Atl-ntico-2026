# Zanqui · variables del backend. Copia a backend/.env (que NO se sube: está en .gitignore) y llénalo.
# Este archivo solo lleva NOMBRES. Nunca pongas valores reales aquí.

# Proyecto Supabase (Settings > API)
SUPABASE_URL=
# Clave pública «anon»: va en la app y en la web. Es pública por diseño; la protegen las reglas del servidor.
SUPABASE_ANON_KEY=
# Clave «service_role»: SOLO para el bot de WhatsApp y los scripts del servidor. NUNCA en la app, la web ni el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Para compilar la app Flutter (--dart-define). Mismos valores de arriba.
ZANQUI_API=
ZANQUI_ANON=

# Para correr zonas/seed con psql en vez del SQL Editor (opcional; Settings > Database)
SUPABASE_DB_URL=
