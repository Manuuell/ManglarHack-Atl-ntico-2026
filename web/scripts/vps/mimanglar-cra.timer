# Revisa manglarcra.netlify.app cada 15 minutos. Solo baja lo que cambió (ETag),
# y repone la copia si un despliegue con rsync --delete la borró.
[Unit]
Description=Revisa cada 15 minutos los datos del workflow de la C.R.A.

[Timer]
OnBootSec=2min
OnCalendar=*:0/15
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
