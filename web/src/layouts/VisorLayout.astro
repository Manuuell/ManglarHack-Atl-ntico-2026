---
// Página de un visor: cabecera con el menú «Visores», título, pestañas para saltar
// entre visores y el mapa (slot) a lo ancho.
import BaseLayout from './BaseLayout.astro';
import CabeceraCRA from '../components/layout/CabeceraCRA.astro';
import { VISORES } from '../lib/navegacion';
interface Props {
  /** id del visor en lib/navegacion.ts; sin él, es el índice /visores. */
  pagina?: string;
  titulo: string;
  resumen: string;
  rotulo?: string;
}
const { pagina, titulo, resumen, rotulo = 'Visor' } = Astro.props;
---
<BaseLayout title={`${titulo} · Visores del manglar del Atlántico`} description={resumen}>
  <a href="#contenido" class="sr-only fixed left-4 top-4 z-50 rounded-full bg-superficie p-3 focus:not-sr-only">Saltar al contenido</a>
  <CabeceraCRA activo="visores" pagina={pagina} rotulo="VISORES · EL MANGLAR DEL ATLÁNTICO" />
  <main id="contenido" class="mx-auto max-w-[1440px] px-4 pb-14 pt-8 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div class="min-w-0 max-w-3xl">
        <p class="rotulo text-dorado-300">{rotulo}</p>
        <h1 class="titular mt-2 text-3xl sm:text-4xl">{titulo}</h1>
        <p class="mt-3 leading-relaxed text-suave">{resumen}</p>
      </div>
      {pagina && (
        <nav aria-label="Otros visores" class="pestanas -mx-4 flex max-w-full gap-2 overflow-x-auto px-4 sm:mx-0 sm:px-0">
          {VISORES.map((v) => (
            <a href={v.href} aria-current={v.id === pagina ? 'page' : undefined}
               class:list={['inline-flex min-h-11 shrink-0 items-center rounded-full border px-4 text-sm font-semibold transition-colors',
                v.id === pagina ? 'border-dorado-500 bg-dorado-500 text-cra-950' : 'border-linea bg-white/5 text-suave hover:border-dorado-300 hover:text-texto']}>{v.texto}</a>
          ))}
        </nav>
      )}
    </div>
    <div class="mt-6"><slot /></div>
  </main>
</BaseLayout>
<style>
  .pestanas { scrollbar-width: none; }
  .pestanas::-webkit-scrollbar { display: none; }
</style>
