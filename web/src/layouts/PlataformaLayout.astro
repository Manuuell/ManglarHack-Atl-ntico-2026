---
import BaseLayout from './BaseLayout.astro';
import CabeceraCRA from '../components/layout/CabeceraCRA.astro';
interface Props {
 title: string;
 activa: 'inicio' | 'registro' | 'proponer' | 'seguimiento' | 'monitoreo' | 'proyectos' | 'panel';
 ancho?: 'normal' | 'completo';
}
const { title, activa, ancho = 'normal' } = Astro.props;
const secciones = [
 { id: 'inicio', href: '/plataforma', texto: 'Inicio' },
 { id: 'registro', href: '/plataforma/registro', texto: 'Registro de actor' },
 { id: 'proponer', href: '/plataforma/proponer', texto: 'Proponer acción' },
 { id: 'seguimiento', href: '/plataforma/seguimiento', texto: 'Seguimiento y jornadas' },
 { id: 'monitoreo', href: '/plataforma/monitoreo', texto: 'Monitoreo comunitario' },
 { id: 'proyectos', href: '/plataforma/proyectos', texto: 'Proyectos' },
 { id: 'panel', href: '/plataforma/panel', texto: 'Panel de la Corporación' },
];
---
<BaseLayout title={title}>
 <a href="#contenido" class="sr-only fixed left-4 top-4 z-50 rounded-full bg-superficie p-3 focus:not-sr-only">Saltar al contenido</a>
 <CabeceraCRA activo="plataforma" />
 <header class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
   <div class="absolute -top-40 right-[-10%] h-[28rem] w-[28rem] rounded-full bg-cra-600/30 blur-[110px]"></div>
   <div class="absolute -bottom-32 left-[-8%] h-[22rem] w-[22rem] rounded-full bg-dorado-500/10 blur-[100px]"></div>
  </div>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-6 sm:px-6 lg:px-8 lg:pt-14">
   <p class="rotulo mb-4 text-dorado-300">Entrada 2 · Corporación Autónoma Regional del Atlántico</p>
   <h1 class="titular max-w-4xl text-4xl sm:text-5xl">Plataforma abierta para la <span class="resalte">restauración</span> y conservación del manglar</h1>
   <p class="mt-5 max-w-3xl text-base leading-relaxed text-suave sm:text-lg">Comunidades, entidades, academia, empresas y ciudadanos proponen, ejecutan y monitorean acciones sobre el manglar, y la autoridad ambiental las revisa y acompaña desde un solo lugar. Aquí llegan también los reportes de la app y del bot de WhatsApp de Zanky.</p>
  </div>
  <nav aria-label="Secciones de la plataforma" class="pestanas mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 pb-4 sm:px-6 lg:px-8">
   {secciones.map(({ id, href, texto }) => (
    <a href={href} aria-current={activa === id ? 'page' : undefined}
       class:list={['inline-flex min-h-11 shrink-0 items-center rounded-full border px-4 text-sm font-semibold transition-colors',
        activa === id ? 'border-dorado-500 bg-dorado-500 text-cra-950' : 'border-linea bg-white/5 text-suave hover:border-dorado-300 hover:text-texto']}>{texto}</a>
   ))}
  </nav>
 </header>
 <main id="contenido" class:list={['mx-auto px-4 py-8 sm:px-6 lg:px-8', ancho === 'normal' && 'max-w-7xl']}><slot /></main>
</BaseLayout>
<style>
 .pestanas { scrollbar-width: none; }
 .pestanas::-webkit-scrollbar { display: none; }
</style>
