---
import BaseLayout from '../layouts/BaseLayout.astro';
import Zanqui from '../components/marca/Zanqui.astro';
const entradas = [
 { numero: 'ENTRADA 1', titulo: 'WORKFLOW', href: '/workflow', texto: 'La metodología paso a paso y el visor de datos: extensión, cambios, dosel, altura, agua, presión y riesgo, carbono.' },
 { numero: 'ENTRADA 2', titulo: 'PLATAFORMA ABIERTA PARA LA RESTAURACIÓN Y CONSERVACIÓN DEL MANGLAR', href: '/plataforma', texto: 'El espacio donde comunidades, entidades y ciudadanos proponen siembras, restauración y acciones de conservación, las siguen con la autoridad ambiental y formulan proyectos. Integra los reportes de la app y del bot de Zanqui.' },
];
---
<BaseLayout>
 <a href="#contenido" class="sr-only fixed left-4 top-4 z-50 bg-superficie p-3 focus:not-sr-only">Saltar al contenido</a>
 <main id="contenido">
  <section aria-labelledby="titulo-portada" class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-linear-to-br from-cra-700 to-cra-950">
   <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -right-24 top-16 h-[34rem] w-[34rem] rounded-full bg-capa-manglar/25 blur-[100px]"></div>
    <div class="absolute -left-32 top-1/3 h-[28rem] w-[28rem] rounded-full bg-capa-agua/20 blur-[100px]"></div>
    <svg aria-hidden="true" focusable="false" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full fill-none stroke-white/10">
     {Array.from({ length: 12 }, (_, i) => <path d="M800 -160C450 20 1210 130 900 360S380 440 720 690s800 160 640 500" transform={`translate(${i * 31} ${i * -14})`} stroke-width="1" />)}
    </svg>
   </div>
   <header class="mx-auto w-full max-w-7xl px-4 pt-8 sm:px-6 lg:px-8 lg:pt-12">
    <img src="/marca/logo-cra-blanco.png" alt="Corporación Autónoma Regional del Atlántico" class="h-20 w-auto" />
   </header>
   <div class="mx-auto mt-auto w-full max-w-7xl px-4 pt-20 pb-7 sm:px-6 lg:px-8 lg:pt-28">
    <p class="rotulo mb-5 text-dorado-300">DEPARTAMENTO DEL ATLÁNTICO · MONITOREO SATELITAL 2015–2026</p>
    <h1 id="titulo-portada" class="titular max-w-4xl text-5xl sm:text-6xl lg:text-7xl">EL MANGLAR DEL ATLÁNTICO</h1>
    <p class="mt-6 max-w-2xl text-sm font-black uppercase leading-relaxed lg:text-base">Implementación de herramientas tecnológicas y de inteligencia artificial para la gestión integral del ecosistema de manglar</p>
    <div class="mt-8 grid border-t border-white/60 md:grid-cols-2">
     {entradas.map(({ numero, titulo, href, texto }) => <a href={href} class="group relative min-h-11 border-b border-linea py-7 md:border-b-0 md:pr-10 md:last:border-l md:last:pl-10 md:last:pr-0">
      <p class="rotulo mb-3 text-dorado-300">{numero}</p>
      <h2 class="titular pr-8 text-2xl transition-colors group-hover:text-dorado-300 group-focus-visible:text-dorado-300">{titulo}</h2>
      <span aria-hidden="true" class="absolute top-12 right-2 text-3xl text-dorado-300 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">→</span>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-suave">{texto}</p>
     </a>)}
    </div>
    <p class="mt-4 text-xs leading-relaxed text-tenue">Cifras del workflow de monitoreo de la C.R.A. (Sentinel-2, programa Copernicus) · Equipo SENTRALABS · UTB</p>
   </div>
  </section>
  <section aria-label="Reporta con Zanqui" class="border-t border-linea-suave bg-superficie">
   <div class="mx-auto flex max-w-7xl flex-col items-start gap-4 px-4 py-6 sm:flex-row sm:items-center sm:px-6 lg:px-8">
    <Zanqui class="h-[72px] w-[72px] shrink-0" />
    <p class="max-w-2xl font-bold text-suave">¿Viste algo raro en el manglar? Repórtalo con Zanqui por WhatsApp o desde la app.</p>
    <a href="/plataforma/monitoreo" class="inline-flex min-h-11 items-center text-sm font-black text-dorado-300 underline underline-offset-4 sm:ml-auto">Ver el monitoreo comunitario</a>
   </div>
  </section>
 </main>
</BaseLayout>