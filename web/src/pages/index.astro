---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Ecosistema from '../components/sections/Ecosistema.astro';
import MapaSection from '../components/sections/MapaSection.astro';
import PanelSection from '../components/sections/PanelSection.astro';
import Comunidad from '../components/sections/Comunidad.astro';
import { obtenerReportes, obtenerPoligonos, obtenerColegios, obtenerHistorial } from '../lib/datos';
import { aReportePublico } from '../lib/privacidad';
const [reportes, poligonos, colegios, historial] = await Promise.all([obtenerReportes(), obtenerPoligonos(), obtenerColegios(), obtenerHistorial()]);
---
<BaseLayout>
 <Hero totalReportes={reportes.length} totalZonas={poligonos.features.length} totalColegios={colegios.length} />
 <Ecosistema />
 <MapaSection reportes={reportes.map(aReportePublico)} poligonos={poligonos} />
 <PanelSection historial={historial} reportes={reportes} poligonos={poligonos} />
 <Comunidad colegios={colegios} />
</BaseLayout>
