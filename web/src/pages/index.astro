---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/portada.css';
import { obtenerPoligonos, obtenerReportes } from '../lib/datos';
import { aReportePublico } from '../lib/privacidad';
import { ESTADOS, TIPOS, PRIORIDADES, nivelPrioridad } from '../lib/catalogos';
import { obtenerJornadas } from '../lib/plataforma/datos';

// Los visores leen las mismas capas de datos que la plataforma: lo público pasa por aReportePublico.
const [reportes, sectores, jornadas] = await Promise.all([obtenerReportes(), obtenerPoligonos(), obtenerJornadas()]);
const publicos = reportes.map(aReportePublico);
const visibles = publicos.filter((r) => r.estado !== 'descartado');
const caso = (id: string) => 'ZK-' + id.replace(/-/g, '').slice(0, 4).toUpperCase();

const abiertos = visibles.filter((r) => ESTADOS[r.estado].abierto);
const kpis = {
  abiertos: abiertos.length,
  alta: abiertos.filter((r) => r.prioridad >= 4).length,
  verificacion: abiertos.filter((r) => r.estado === 'en_verificacion').length,
  alertas: abiertos.filter((r) => r.estado === 'alerta_oficial').length,
};
const lista = [...abiertos].sort((a, b) => b.prioridad - a.prioridad || b.capturado_en.localeCompare(a.capturado_en)).slice(0, 5);
const destacado = lista[0];
const proximas = [...jornadas].sort((a, b) => a.inicio.localeCompare(b.inicio)).slice(0, 3);
const anillo = (p: number) => (p >= 4 ? '#f87171' : p === 3 ? '#fbbf24' : '#4ade80');

const zona = { timeZone: 'America/Bogota' } as const;
const dia = (iso: string) => new Intl.DateTimeFormat('es-CO', { ...zona, day: 'numeric' }).format(new Date(iso));
const mes = (iso: string) => new Intl.DateTimeFormat('es-CO', { ...zona, month: 'short' }).format(new Date(iso)).replace('.', '');
const hora = (iso: string) => new Intl.DateTimeFormat('es-CO', { ...zona, hour: 'numeric', minute: '2-digit' }).format(new Date(iso));
const BANDA: Record<string, string> = {
  siembra: 'linear-gradient(135deg,#22a061,#0b3a58)', limpieza: 'linear-gradient(135deg,#2b87be,#05243a)',
  recorrido_vigias: 'linear-gradient(135deg,#f2c63e,#b45309 60%,#0b3a58)', monitoreo: 'linear-gradient(135deg,#38bdf8,#0b3a58)',
};
const TIPO_JORNADA: Record<string, string> = { siembra: 'Siembra', limpieza: 'Limpieza', recorrido_vigias: 'Recorrido de vigías', monitoreo: 'Monitoreo' };

const datosVisor = {
  sectores,
  reportes: visibles.map((r) => ({
    id: r.id, caso: caso(r.id), tipo: TIPOS[r.tipo].etiquetaLarga, lat: r.lat, lon: r.lon, prioridad: r.prioridad,
    estado: ESTADOS[r.estado].etiqueta, zona: r.zona, color: PRIORIDADES[nivelPrioridad(r.prioridad)].color,
    reciente: ESTADOS[r.estado].abierto && r.prioridad >= 4,
  })),
  exportar: publicos,
};
---
<BaseLayout title="Zanky · El manglar del Atlántico, vigilado por su gente" class="portada" sinPie>
  <header class="cab" id="cab">
    <a class="cab-marca" href="#inicio" aria-label="Zanky y la C.R.A., inicio">
      <img class="logo-cra" src="/marca/logo-cra-blanco.png" alt="Corporación Autónoma Regional del Atlántico" />
      <span class="sep" aria-hidden="true"></span>
      <span class="nombre"><img src="/marca/zanky/zanky-feliz-256.webp" alt="" />Zanky</span>
    </a>
    <nav class="cab-nav" aria-label="Secciones">
      <a href="#reto">El reto</a>
      <a href="#reportar">Reportar</a>
      <a href="#panel">Panel C.R.A.</a>
      <a href="#datos">Datos abiertos</a>
      <a href="#jornadas">Jornadas</a>
    </nav>
    <a class="boton boton-tinta cab-entrar" href="/plataforma">Plataforma</a>
  </header>

  <main>
    <!-- Hero: el manglar en vivo -->
    <section class="hero" id="inicio">
      <div class="hero-texto">
        <h1>El manglar del Atlántico, <span class="resalte">vigilado</span> por su gente.</h1>
        <p class="hero-sub">Quien vive o visita el manglar reporta una amenaza en segundos, aun sin señal. La C.R.A. la ve aquí, la verifica y actúa.</p>
        <div class="hero-acciones">
          <a class="boton boton-tinta" href="#reportar">Cómo se reporta <span aria-hidden="true">→</span></a>
          <a class="boton boton-claro" href="/plataforma/monitoreo">Ver el monitoreo</a>
        </div>
      </div>
      <div class="hero-escena">
        <div class="visor" role="region" aria-label="Visor del manglar del Atlántico: sectores de manglar y reportes ciudadanos de ejemplo sobre el mapa.">
          <div class="visor-mapa" id="visor-mapa"></div>
          <div class="visor-barra">
            <span class="visor-chip"><span class="punto" aria-hidden="true"></span>Reportes ciudadanos</span>
            <span class="visor-chip ejemplo">Datos de ejemplo</span>
          </div>
        </div>
        <p class="pegatina p1"><b>775 ha</b>manglar probable en 2025</p>
        <p class="pegatina p2"><b>4</b>sectores, de Mallorquín al Totumo</p>
        <p class="pegatina p3"><b>−34,7 ha</b>pérdida entre 2016 y 2025</p>
        <p class="pegatina p4"><img src="/marca/zanky/zanky-curioso-256.webp" alt="" /></p>
      </div>
    </section>

    <!-- Franja dorada -->
    <section class="franja">
      <div class="contenedor franja-fila" data-reveal>
        <p>Meta: que ninguna amenaza al manglar se conozca tarde. Así respondemos las 3 preguntas de la C.R.A.</p>
        <a class="boton boton-tinta" href="#reto">Ver el reto</a>
      </div>
    </section>

    <!-- El reto -->
    <section class="reto" id="reto">
      <div class="contenedor">
        <div class="reto-dentro">
          <div class="reto-titulo" data-reveal="left">
            <p class="kicker">El reto</p>
            <h2>La C.R.A. se entera tarde. <span class="subraya">Quien vive el manglar lo ve primero.</span></h2>
            <blockquote class="reto-enunciado">
              <p>«Diseña y prototipa una herramienta digital de ciencia ciudadana para monitorear en tiempo real el manglar del Atlántico.»</p>
              <cite>ManglarHack Atlántico 2026 · C.R.A. y Universidad Simón Bolívar</cite>
            </blockquote>
          </div>
          <ol class="reto-filas" data-reveal="right">
            <li><strong>01</strong><span><b>¿Dónde y con qué prioridad?</b>GPS del celular sobre la capa de manglar de la C.R.A. y prioridad de 1 a 5.</span></li>
            <li><strong>02</strong><span><b>¿Es confiable el dato?</b>Confianza por capas y una persona que verifica antes del expediente.</span></li>
            <li><strong>03</strong><span><b>¿La gente sigue?</b>Aviso de qué pasó con su reporte, jornadas, vigías y colegios.</span></li>
          </ol>
        </div>

        <div class="ataque">
          <div class="ataque-cab" data-reveal>
            <p class="kicker">Cómo funciona</p>
            <h3>Reportar. Ubicar. Verificar. Publicar.</h3>
          </div>
          <ol class="ataque-pasos">
            <li data-reveal data-reveal-delay="0"><span class="ataque-n">1</span><b>Reportar</b><p>Por la app, WhatsApp o la web, aun sin señal.</p><a href="#reportar">Ver el chat →</a></li>
            <li data-reveal data-reveal-delay="80"><span class="ataque-n">2</span><b>Ubicar</b><p>El punto cae en su sector del manglar con su prioridad.</p><a href="#ubicar">Ver la cola →</a></li>
            <li data-reveal data-reveal-delay="160"><span class="ataque-n">3</span><b>Verificar</b><p>La C.R.A. revisa la evidencia y abre el expediente.</p><a href="#panel">Ver el panel →</a></li>
            <li data-reveal data-reveal-delay="240"><span class="ataque-n">4</span><b>Publicar</b><p>Datos abiertos sin datos personales.</p><a href="#datos">Descargar →</a></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- 01 Reportar -->
    <section class="panel" data-tono="abismo" id="reportar">
      <div class="panel-dentro dividido">
        <div class="panel-texto" data-reveal="left">
          <p class="kicker">01 · Reportar</p>
          <h2>Tres toques y <span class="tono">listo</span>, aun sin señal.</h2>
          <ul class="puntos">
            <li><b>App, WhatsApp o web por QR:</b> nada que instalar para empezar</li>
            <li><b>Sin señal:</b> se guarda y se envía al volver, sin duplicarse</li>
            <li><b>Foto, ubicación y hora</b> en el momento</li>
          </ul>
        </div>
        <div class="maqueta maqueta-chat" id="chat" aria-label="Conversación de ejemplo con Zanky BOT por WhatsApp" role="group" data-reveal="card" data-reveal-delay="100">
          <div class="chat-cab"><img src="/marca/zanky/zanky-feliz-256.webp" alt="" /><span><b>Zanky BOT</b><small>en línea</small></span></div>
          <div class="chat-cuerpo">
            <div class="msg yo">Hola<small>10:38</small></div>
            <div class="msg zanky">¡Ajá! Soy <b>Zanky</b>, el vigía del manglar. ¿Qué quieres hacer?<div class="msg-botones"><span>🚨 Reportar</span><span>🌱 Jornadas</span></div></div>
            <div class="msg yo">🔥 Quema o incendio<small>10:38</small></div>
            <div class="msg yo"><div class="msg-mapa" aria-hidden="true"></div>Ubicación actual<small>10:39</small></div>
            <div class="msg zanky">✅ Está <b>dentro del manglar</b> (Mallorquín).</div>
            <div class="msg zanky">🌿 ¡Gracias, vigía! Tu reporte <b>ZK-4C6C</b> ya está en el panel de la C.R.A.<small>10:40</small></div>
          </div>
          <div class="chat-pie"><button type="button" class="repetir" id="chat-repetir" hidden>↻ Ver de nuevo</button></div>
        </div>
      </div>
    </section>

    <!-- 02 Ubicar -->
    <section class="panel" data-tono="hondo" id="ubicar">
      <div class="panel-dentro dividido invertido">
        <div class="maqueta maqueta-lista" aria-label="Cola de reportes ordenada por prioridad" role="group" data-reveal="card">
          <div class="mq-cab"><b>Reportes · por prioridad</b><span class="sello ejemplo">datos de ejemplo</span></div>
          {lista.map((r, i) => (
            <div class:list={['mq-fila', i === 0 && 'activa']}>
              <i style={`--t:${anillo(r.prioridad)}`}>{r.prioridad}</i>
              <span>
                <b>{TIPOS[r.tipo].etiquetaLarga} · {r.zona}</b>
                <small>{caso(r.id)} · {r.municipio}</small>
                <span class="sellos">
                  <em class:list={['sello', r.dentro_poligono ? 'dentro' : 'cerca']}>{r.dentro_poligono ? 'dentro del manglar' : `a ${r.distancia_m ?? '—'} m`}</em>
                  <em class:list={['sello', r.estado === 'alerta_oficial' ? 'alerta' : 'estado']}>{ESTADOS[r.estado].etiqueta}</em>
                </span>
              </span>
            </div>
          ))}
        </div>
        <div class="panel-texto" data-reveal="right" data-reveal-delay="100">
          <p class="kicker">02 · Ubicar y priorizar</p>
          <h2>Cada reporte cae <span class="tono">en su sector</span>.</h2>
          <p>El punto se cruza con la cobertura de manglar de la C.R.A. (1:5.000) y su área de influencia de 500 m. La prioridad sube si es grave, si pasa ahora o si otros lo confirman.</p>
        </div>
      </div>
    </section>

    <!-- 03 Panel de la C.R.A. -->
    <section class="panel" data-tono="arena" id="panel">
      <div class="panel-dentro dividido">
        <div class="panel-texto" data-reveal="left">
          <p class="kicker">03 · Verificar</p>
          <h2>Ningún dato llega al expediente <span class="tono">sin una persona</span>.</h2>
          <p>La confianza se arma por capas y un vigía o un funcionario la confirma antes de la alerta oficial.</p>
          <a class="boton boton-tinta" style="margin-top:26px" href="/plataforma/panel">Abrir el panel <span aria-hidden="true">→</span></a>
        </div>
        {destacado && (
          <div class="maqueta maqueta-panel" id="demo-panel" role="group" aria-label="Boceto del panel de la C.R.A.: indicadores, confianza del reporte y su paso de recibido a alerta oficial." data-reveal="card" data-reveal-delay="100">
            <div class="gd-barra">
              <span class="gd-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
              <b>Panel de la C.R.A. · demostración</b>
              <span class="gd-reloj">en vivo</span>
            </div>
            <div class="gd-cuerpo">
              <div class="gd-kpis">
                <div class="gd-kpi"><span>Abiertos</span><b>{kpis.abiertos}</b></div>
                <div class="gd-kpi alto"><span>Prioridad alta</span><b>{kpis.alta}</b></div>
                <div class="gd-kpi"><span>En verificación</span><b>{kpis.verificacion}</b></div>
                <div class="gd-kpi"><span>Alertas</span><b>{kpis.alertas}</b></div>
              </div>
              <div class="gd-caso">
                <div class="gd-caso-cab"><b>{caso(destacado.id)} · {TIPOS[destacado.tipo].etiquetaLarga}</b><span>{destacado.zona} · prioridad {destacado.prioridad}</span></div>
                <div class="gd-confianza"><div class="gd-barra-conf"><i id="gd-conf-barra"></i></div><output id="gd-conf">0</output></div>
                <div class="gd-motivos" id="gd-motivos"><span data-p="25">foto +25</span><span data-p="20">GPS +20</span><span data-p="15">dentro del manglar +15</span><span data-p="10">pasa ahora +10</span><span data-p="10">otro vecino lo confirma +10</span></div>
                <div class="gd-pasos" id="gd-pasos"><span>Recibido</span><span>En verificación</span><span>Verificado</span><span>Alerta oficial</span></div>
              </div>
              <div class="gd-pie"><span id="gd-estado">Llega el reporte…</span><button type="button" class="repetir" id="gd-repetir" hidden>↻ Ver de nuevo</button></div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Banda ancha -->
    <section class="ancha">
      <div class="contenedor ancha-texto" data-reveal="scale">
        <img class="ancha-zanky" src="/marca/zanky/zanky-preocupado-256.webp" alt="" />
        <h2>El manglar es la primera defensa del Atlántico contra el mar.</h2>
        <p>Guarda carbono, cría peces y se recupera si llegamos a tiempo.</p>
      </div>
    </section>

    <!-- 04 Datos abiertos -->
    <section class="datos" id="datos">
      <div class="contenedor">
        <div class="datos-cab" data-reveal>
          <p class="kicker">04 · Publicar</p>
          <h2>Datos abiertos, <span class="subraya">sin datos personales</span>.</h2>
          <p>Sin nombres, fotos ni teléfonos, y la ubicación difuminada. Licencia CC BY 4.0, como pide Gobierno Digital.</p>
        </div>
        <ol class="filas">
          <li data-reveal data-reveal-delay="0"><span class="formato">GeoJSON</span><b>Para mapas y SIG</b><span>QGIS, ArcGIS, Leaflet.</span><button type="button" class="boton boton-tinta boton-descarga" data-exportar="geojson">Descargar</button></li>
          <li data-reveal data-reveal-delay="70"><span class="formato">CSV</span><b>Para hojas de cálculo</b><span>Excel, Google Sheets, datos.gov.co.</span><button type="button" class="boton boton-tinta boton-descarga" data-exportar="csv">Descargar</button></li>
          <li data-reveal data-reveal-delay="140"><span class="formato">KML</span><b>Para Google Earth</b><span>Cada reporte como un punto con su estado.</span><button type="button" class="boton boton-tinta boton-descarga" data-exportar="kml">Descargar</button></li>
        </ol>
        <p class="datos-aviso">Datos de ejemplo hasta conectar el backend común; el formato y los campos son los definitivos.</p>
      </div>
    </section>

    <!-- 05 Jornadas -->
    <section class="panel" data-tono="abismo" id="jornadas">
      <div class="panel-dentro">
        <div data-reveal>
          <p class="kicker">05 · Participar</p>
          <h2 style="max-width:18ch">Siembras, limpiezas y recorridos: <span class="tono">la gente vuelve</span>.</h2>
        </div>
        <div class="jornadas-grid">
          {proximas.map((j, i) => (
            <a class="jornada-mini" href={`/plataforma/jornadas?jornada=${j.id}`} data-reveal data-reveal-delay={i * 80}>
              <span class="banda" style={`display:block;--g:${BANDA[j.tipo] ?? BANDA.siembra}`}><span class="fecha"><b>{dia(j.inicio)}</b><small>{mes(j.inicio)}</small></span></span>
              <span class="cuerpo" style="display:block"><small>{TIPO_JORNADA[j.tipo]}</small><b>{j.titulo}</b><span>{hora(j.inicio)} · {j.punto_encuentro}</span></span>
            </a>
          ))}
        </div>
        <div style="margin-top:28px" data-reveal><a class="boton boton-dorado" href="/plataforma/jornadas">Ver todas las jornadas <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <!-- Cierre -->
    <section class="cierre">
      <div class="cierre-dentro" data-reveal="scale">
        <h2>El manglar se cuida entre todos.</h2>
        <p>Reporta lo que ves, súmate a una jornada o revisa el panel.</p>
        <div class="acciones">
          <a class="boton boton-tinta boton-grande" href="/plataforma/monitoreo">Reportar con Zanky <span aria-hidden="true">→</span></a>
          <a class="boton boton-claro boton-grande" href="/plataforma">Entrar a la plataforma</a>
        </div>
        <img class="cierre-zanky" src="/marca/zanky/zanky-celebrando-512.webp" alt="" loading="lazy" />
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="pie-dentro">
      <div class="pie-alto">
        <p class="pie-lema"><span class="blanco">El manglar del Atlántico,</span> <span class="pie-agua">vigilado por su gente</span></p>
        <a class="pie-cta" href="/plataforma/panel">¿Eres de la C.R.A.? <b>Entrar al panel</b> <span aria-hidden="true">→</span></a>
      </div>
      <div class="pie-columnas">
        <nav aria-label="La portada">
          <h3>Explorar</h3>
          <a href="#reto">El reto</a>
          <a href="#reportar">Cómo se reporta</a>
          <a href="#panel">Panel de la C.R.A.</a>
          <a href="#datos">Datos abiertos</a>
        </nav>
        <nav aria-label="Plataforma">
          <h3>Plataforma</h3>
          <a href="/workflow">Workflow satelital</a>
          <a href="/plataforma/monitoreo">Monitoreo comunitario</a>
          <a href="/plataforma/jornadas">Jornadas</a>
          <a href="/plataforma/panel">Panel de la Corporación</a>
        </nav>
        <div class="pie-sobre">
          <h3>Zanky</h3>
          <p>Ciencia ciudadana para el manglar del Atlántico: la gente reporta, la C.R.A. verifica y todos ven los datos abiertos. Cifras del workflow de la C.R.A. (Sentinel-2, Copernicus); imágenes satelitales del visor © Esri y Maxar.</p>
        </div>
      </div>
      <div class="pie-aliados">
        <span class="pie-etiqueta">Un reto de</span>
        <div class="pie-logos">
          <span class="pie-logo"><img src="/marca/logo-cra-blanco.png" alt="Corporación Autónoma Regional del Atlántico" /></span>
          <span class="pie-logo"><b class="pie-logo-texto">Universidad Simón Bolívar</b></span>
        </div>
      </div>
      <div class="pie-bajo">
        <span>© 2026 Zanky · ManglarHack Atlántico · Equipo SENTRALABS · UTB</span>
        <span class="pie-hecho">Hecho con
          <svg class="corazon" viewBox="0 0 24 24" role="img" aria-label="corazón">
            <path fill="#da121a" d="M12 21.5s-7.6-4.7-10.1-9.4C.2 8.8 1.9 4.6 5.8 4.2 8.1 4 10 5.3 12 7.4c2-2.1 3.9-3.4 6.2-3.2 3.9.4 5.6 4.6 3.9 7.9C19.6 16.8 12 21.5 12 21.5z"/>
            <path fill="#fcd116" transform="translate(12 12.6) scale(.68) translate(-12 -12.6)" d="M12 21.5s-7.6-4.7-10.1-9.4C.2 8.8 1.9 4.6 5.8 4.2 8.1 4 10 5.3 12 7.4c2-2.1 3.9-3.4 6.2-3.2 3.9.4 5.6 4.6 3.9 7.9C19.6 16.8 12 21.5 12 21.5z"/>
            <path fill="#078930" transform="translate(12 12.6) scale(.38) translate(-12 -12.6)" d="M12 21.5s-7.6-4.7-10.1-9.4C.2 8.8 1.9 4.6 5.8 4.2 8.1 4 10 5.3 12 7.4c2-2.1 3.9-3.4 6.2-3.2 3.9.4 5.6 4.6 3.9 7.9C19.6 16.8 12 21.5 12 21.5z"/>
          </svg>
          en el Caribe colombiano</span>
      </div>
    </div>
  </footer>

  <script type="application/json" id="datos-portada" set:html={JSON.stringify(datosVisor)} />
</BaseLayout>

<script>
  import { montarPortada } from '../scripts/portada';
  montarPortada();
</script>
