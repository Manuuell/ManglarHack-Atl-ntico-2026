---
import PlataformaLayout from '../../layouts/PlataformaLayout.astro';
import CanalesZanky from '../../components/monitoreo/CanalesZanky.astro';
import MapaMonitoreo from '../../components/mapa/MapaMonitoreo';
import ReporteMonitoreo from '../../components/monitoreo/ReporteMonitoreo';
import Comunidad from '../../components/sections/Comunidad.astro';
import Badge from '../../components/ui/Badge.astro';
import { obtenerColegios, obtenerPoligonos, obtenerReportes } from '../../lib/datos';
import { obtenerAcciones, obtenerMonitoreos } from '../../lib/plataforma/datos';
import { aReportePublico } from '../../lib/privacidad';

const [reportes, zonas, colegios, acciones, monitoreos] = await Promise.all([
  obtenerReportes(),
  obtenerPoligonos(),
  obtenerColegios(),
  obtenerAcciones(),
  obtenerMonitoreos(),
]);
// Esta página es pública: los reportes salen sin foto, sin reportante y con
// la ubicación difuminada.
const publicos = reportes.map(aReportePublico);
---

<PlataformaLayout title="Monitoreo comunitario · Plataforma abierta del manglar" activa="monitoreo">
  <div class="grid gap-14">
    <section aria-labelledby="titulo-reportes" class="grid gap-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-3">
        <h2 id="titulo-reportes" class="rotulo text-dorado-300">Reportes ciudadanos · Zanky</h2>
        <Badge tono="ejemplo">Datos de ejemplo</Badge>
      </div>
      <CanalesZanky />
      <MapaMonitoreo client:only="react" reportes={publicos} poligonos={zonas}>
        <div slot="fallback" class="grid h-[600px] place-items-center border border-linea bg-fondo-alt text-tenue">Cargando el mapa de reportes…</div>
      </MapaMonitoreo>
    </section>

    <section aria-labelledby="titulo-monitoreo" class="grid gap-6">
      <div class="border-b border-linea pb-3">
        <h2 id="titulo-monitoreo" class="rotulo text-dorado-300">Monitoreo de las acciones</h2>
        <p class="mt-2 max-w-3xl text-sm text-suave">
          Quien ejecuta una acción reporta a la Corporación la supervivencia de las plántulas, su altura y fotografías ubicadas, en las fechas que la Corporación defina.
        </p>
      </div>
      <ReporteMonitoreo client:only="react" acciones={acciones} monitoreos={monitoreos}>
        <div slot="fallback" class="grid h-[520px] place-items-center border border-linea bg-fondo-alt text-tenue">Cargando el formulario de monitoreo…</div>
      </ReporteMonitoreo>
    </section>
  </div>
  <Comunidad colegios={colegios} />
</PlataformaLayout>
