---
import { cn } from '../../lib/utils';
import { PRIORIDADES_ZONA } from '../../lib/catalogos';
interface Props { tono?: 'neutro' | 'agua' | 'manglar' | 'critica' | 'alta' | 'media' | 'baja'; class?: string; }
const { tono = 'neutro', class: clase } = Astro.props;
const tonos = {
 neutro: 'bg-fondo-alt text-suave ring-1 ring-linea',
 agua: 'bg-agua-50 text-agua-700 ring-1 ring-agua-500/25',
 manglar: 'bg-manglar-50 text-manglar-700 ring-1 ring-manglar-500/25',
 critica: PRIORIDADES_ZONA.critica.chip, alta: PRIORIDADES_ZONA.alta.chip,
 media: PRIORIDADES_ZONA.media.chip, baja: PRIORIDADES_ZONA.baja.chip,
};
---
<span class={cn('inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium', tonos[tono], clase)}><slot /></span>
