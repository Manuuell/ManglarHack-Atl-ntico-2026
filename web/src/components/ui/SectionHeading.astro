---
import { cn } from '../../lib/utils';
interface Props { eyebrow: string; titulo: string; descripcion?: string; align?: 'left' | 'center'; }
const { eyebrow, titulo, descripcion, align = 'left' } = Astro.props;
---
<div class={cn('mb-10 max-w-3xl', align === 'center' && 'mx-auto text-center')}>
 <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-agua-700">{eyebrow}</p>
 <h2 class="text-3xl font-bold text-manglar-950 sm:text-4xl">{titulo}</h2>
 {descripcion && <p class="mt-4 text-base leading-relaxed text-suave sm:text-lg">{descripcion}</p>}
</div>
