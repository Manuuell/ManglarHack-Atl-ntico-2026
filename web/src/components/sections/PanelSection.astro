---
import type { CambioEstado, Reporte, ZonasManglar } from '../../types/manglar';
import SectionHeading from '../ui/SectionHeading.astro';
import PanelCRA from '../panel/PanelCRA';
interface Props { reportes: Reporte[]; poligonos: ZonasManglar; historial: CambioEstado[]; }
const { reportes, poligonos, historial } = Astro.props;
---
<section id="panel" class="bg-fondo-alt py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <SectionHeading eyebrow="Panel de control C.R.A." titulo="Validación y seguimiento de reportes" descripcion="Revisa los aportes ciudadanos, verifica los hallazgos y gestiona los casos que requieren seguimiento. Consulta y comparte los datos abiertos del territorio." />
  <PanelCRA historial={historial} client:load reportes={reportes} poligonos={poligonos} />
 </div>
</section>
