---
import type { ReportePublico, ZonasManglar } from '../../types/manglar';
import SectionHeading from '../ui/SectionHeading.astro';
import MapaMonitoreo from '../mapa/MapaMonitoreo';
interface Props { reportes: ReportePublico[]; poligonos: ZonasManglar; }
const { reportes, poligonos } = Astro.props;
---
<section id="mapa" class="py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <SectionHeading eyebrow="Monitoreo público" titulo="Mapa interactivo de manglares" descripcion="Explora la cobertura INVEMAR 2020, las zonas de trabajo aproximadas y los reportes de ejemplo con ubicaciones protegidas. Las prioridades de las zonas son propuestas del equipo." />
  <MapaMonitoreo client:only="react" reportes={reportes} poligonos={poligonos}>
   <div slot="fallback" role="status" class="relative z-0 h-[520px] sm:h-[600px] rounded-3xl bg-fondo-alt ring-1 ring-linea grid place-items-center text-tenue">Cargando mapa…</div>
  </MapaMonitoreo>
 </div>
</section>
