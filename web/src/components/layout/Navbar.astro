---
import { Map, Menu, X } from 'lucide-react';
import Zanqui from '../marca/Zanqui.astro';
import Button from '../ui/Button.astro';
const enlaces = [['inicio', 'Inicio'], ['ecosistema', 'Ecosistema'], ['mapa', 'Mapa público'], ['panel', 'Panel C.R.A.'], ['comunidad', 'Comunidad']];
---
<header class="fixed inset-x-0 top-0 z-[1100] h-16 border-b border-linea/70 bg-superficie/85 backdrop-blur-md">
 <nav aria-label="Navegación principal" class="mx-auto flex h-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
  <a href="#inicio" class="flex shrink-0 items-center gap-2"><Zanqui class="h-10 w-10" /><span><span class="block text-lg font-bold leading-tight text-manglar-900">Zanqui</span><span class="block text-xs text-tenue">Manglares del Atlántico</span></span></a>
  <div class="hidden items-center gap-3 xl:gap-5 lg:flex">{enlaces.map(([id, texto]) => <a data-seccion={id} href={`#${id}`} class="enlace-seccion py-2 text-sm font-medium text-suave transition hover:text-manglar-900">{texto}</a>)}</div>
  <Button href="#mapa" class="hidden lg:inline-flex"><Map size={16} aria-hidden="true" />Ver el mapa</Button>
  <button id="menu-boton" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" class="rounded-xl p-2 text-manglar-900 lg:hidden"><span data-abrir><Menu size={24} aria-hidden="true" /></span><span data-cerrar hidden><X size={24} aria-hidden="true" /></span></button>
  <div id="menu-movil" hidden class="absolute inset-x-0 top-16 bg-superficie p-4 shadow-[var(--c-sombra-alta)] lg:hidden">
   <div class="mx-auto flex max-w-7xl flex-col gap-2">{enlaces.map(([id, texto]) => <a data-seccion={id} href={`#${id}`} class="enlace-seccion rounded-lg px-3 py-3 text-sm font-medium text-suave">{texto}</a>)}<Button href="#mapa"><Map size={16} aria-hidden="true" />Ver el mapa</Button></div>
  </div>
 </nav>
</header>
<style>
 .enlace-seccion[aria-current="location"] { text-decoration:underline; text-decoration-color:var(--color-agua-500); text-decoration-thickness:3px; text-underline-offset:8px; }
</style>
<script>
 const boton = document.querySelector<HTMLButtonElement>('#menu-boton');
 const menu = document.querySelector<HTMLElement>('#menu-movil');
 function abrirMenu(abierto: boolean) {
  if (!boton || !menu) return;
  boton.setAttribute('aria-expanded', String(abierto));
  boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  menu.hidden = !abierto;
  const abrir = boton.querySelector<HTMLElement>('[data-abrir]');
  const cerrar = boton.querySelector<HTMLElement>('[data-cerrar]');
  if (abrir) abrir.hidden = abierto;
  if (cerrar) cerrar.hidden = !abierto;
 }
 boton?.addEventListener('click', () => abrirMenu(boton.getAttribute('aria-expanded') !== 'true'));
 menu?.querySelectorAll('a').forEach(enlace => enlace.addEventListener('click', () => abrirMenu(false)));
 document.addEventListener('keydown', evento => { if (evento.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') { abrirMenu(false); boton.focus(); } });
 const escritorio = matchMedia('(min-width: 1024px)');
 escritorio.addEventListener('change', evento => { if (evento.matches) abrirMenu(false); });
 const enlaces = document.querySelectorAll<HTMLAnchorElement>('[data-seccion]');
 function marcar(id: string) {
  enlaces.forEach(enlace => {
   const activo = enlace.dataset.seccion === id;
   enlace.classList.toggle('text-manglar-900', activo);
   enlace.classList.toggle('text-suave', !activo);
   if (activo) enlace.setAttribute('aria-current', 'location'); else enlace.removeAttribute('aria-current');
  });
 }
 const observador = new IntersectionObserver(entradas => {
  entradas.forEach(entrada => { if (entrada.isIntersecting) marcar(entrada.target.id); });
 }, { rootMargin: '-64px 0px -60% 0px', threshold: 0 });
 document.querySelectorAll('main section[id]').forEach(seccion => observador.observe(seccion));
 marcar(location.hash.slice(1) || 'inicio');
</script>

