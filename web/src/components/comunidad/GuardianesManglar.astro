---
// Guardianes del manglar en la portada: ranking de colegios y pasaporte del turista.
import Comunidad from '../sections/Comunidad.astro';
import type { Colegio } from '../../types/manglar';
import '../../styles/monitoreo-portada.css';

interface Props { colegios: Colegio[] }
const { colegios } = Astro.props;
---
<section class="panel" data-tono="hondo" id="guardianes" aria-labelledby="titulo-guardianes">
  <div class="panel-dentro">
    <div class="mon-cab" data-reveal>
      <p class="kicker">Sostenibilidad y comunidad</p>
      <h2 id="titulo-guardianes">Guardianes <span class="tono">del manglar</span>.</h2>
      <p class="mon-sub">Colegios, viajeros y comunidades que convierten pequeños gestos en un futuro para el manglar.</p>
    </div>
    <div class="mon" data-reveal>
      <Comunidad colegios={colegios} incrustada />
    </div>
  </div>
</section>
