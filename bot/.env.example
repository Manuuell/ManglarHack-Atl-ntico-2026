# Zanky BOT · copia este archivo como .env y llena los valores.
# Nunca subas el .env al repositorio.

PORT=3000

# Meta WhatsApp Cloud API
# Sin WHATSAPP_TOKEN el bot arranca en modo simulación: imprime los mensajes en vez de enviarlos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú; el mismo que pongas al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta (Configuración > Básica). Con él se verifica la firma de cada webhook.
META_APP_SECRET=
GRAPH_API_VERSION=v25.0

# Clave para el panel web de la CRA (encabezado x-api-key). Usa una cadena larga y aleatoria.
PANEL_API_KEY=
# Sal para guardar los números de teléfono como hash. Cadena larga y aleatoria.
HASH_SALT=

# Backend común (backend/supabase): URL del proyecto y clave anon (pública; la protegen las reglas).
# Sin ellas los reportes de WhatsApp se quedan en la copia local y no se ven en la app ni en la web.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Jornadas comunitarias que publica la web; el bot las ofrece por chat con el enlace de inscripción.
JORNADAS_URL=https://mimanglar.sentralabs.co/datos/jornadas.json

# Datos
DATA_DIR=./data
# Zonas de manglar: el mismo archivo que la app y el backend (formato de la app o GeoJSON).
ZONAS_GEOJSON=../app/assets/datos/manglar_zonas.json
# Distancia (metros) a la que un reporte cuenta como "cerca del manglar".
RADIO_INFLUENCIA_M=500
