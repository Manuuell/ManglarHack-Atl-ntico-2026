# Zanqui BOT · copia este archivo como .env y llena los valores.
# Nunca subas el .env al repositorio.

PORT=3000

# Meta WhatsApp Cloud API
# Sin WHATSAPP_TOKEN el bot arranca en modo simulación: imprime los mensajes en vez de enviarlos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú; el mismo que pongas al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta (Configuración > Básica). Con él se verifica la firma de cada webhook.
META_APP_SECRET=
GRAPH_API_VERSION=v25.0

# Clave para el panel web de la CRA (encabezado x-api-key). Usa una cadena larga y aleatoria.
PANEL_API_KEY=
# Sal para guardar los números de teléfono como hash. Cadena larga y aleatoria.
HASH_SALT=

# Datos
DATA_DIR=./data
# Polígonos del manglar en GeoJSON. Cambiar por los de la CRA cuando lleguen.
ZONAS_GEOJSON=../datos/manglares_atlantico_invemar_2020.geojson
# Distancia (metros) a la que un reporte cuenta como "cerca del manglar".
RADIO_INFLUENCIA_M=500
