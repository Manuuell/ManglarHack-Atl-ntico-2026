# Zanky BOT · copia este archivo como .env y llena los valores.
# Nunca subas el .env al repositorio.

PORT=3000

# Meta WhatsApp Cloud API
# Sin WHATSAPP_TOKEN el bot arranca en modo simulación: imprime los mensajes en vez de enviarlos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú; el mismo que pongas al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta (Configuración > Básica). Con él se verifica la firma de cada webhook.
META_APP_SECRET=
GRAPH_API_VERSION=v25.0

# Clave para el panel web de la CRA (encabezado x-api-key). Usa una cadena larga y aleatoria.
PANEL_API_KEY=
# Sal para guardar los números de teléfono como hash. Cadena larga y aleatoria.
HASH_SALT=

# Backend común (backend/supabase): URL del proyecto y clave anon (pública; la protegen las reglas).
# Sin ellas los reportes de WhatsApp se quedan en la copia local y no se ven en la app ni en la web.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Jornadas comunitarias que publica la web; el bot las ofrece por chat con el enlace de inscripción.
JORNADAS_URL=https://mimanglar.sentralabs.co/datos/jornadas.json

# Datos
DATA_DIR=./data
# Zonas de manglar: el mismo archivo que la app y el backend (formato de la app o GeoJSON).
ZONAS_GEOJSON=../app/assets/datos/manglar_zonas.json
# Área donde se admiten denuncias: cobertura de manglar de la C.R.A. a escala 1:5.000 (la misma regla que la web).
AREA_REPORTE_GEOJSON=../datos/cra/manglar_cra_escala_1-5000.geojson
# Hasta esta distancia (metros) de la cobertura se admite la denuncia; más lejos no se crea el reporte.
RADIO_INFLUENCIA_M=500

# Cada cuánto (ms) se pregunta al backend si la C.R.A. cambió el estado de un reporte, para avisar por WhatsApp.
SONDEO_ESTADOS_MS=300000
# Página de la web para seguir un caso (opcional). El bot manda <SEGUIMIENTO_URL>#caso=<uuid>.
# Déjala vacía hasta que la web tenga esa página (ver handoff/13-integracion-bot-web.md).
SEGUIMIENTO_URL=

# OpenAI: Zanky conversa en la burbuja de la web (POST /chat) y responde preguntas libres en WhatsApp.
# La clave solo va aquí, en el servidor; nunca en la web ni en el repo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Sitios que pueden llamar a /chat desde el navegador (separados por coma).
CHAT_ORIGENES=https://mimanglar.sentralabs.co,http://localhost:4329
